# LLM (Groq)
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b     # model Groq sinh câu trả lời / agent (phải hỗ trợ tool calling)
JUDGE_MODEL=openai/gpt-oss-20b    # model Groq chấm điểm RAGAS

# Data APIs (Open-Meteo Air Quality không cần key)
NOMINATIM_USER_AGENT=hcmc-aq-agent/0.1 (your-email@example.com)

# Tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hcmc-aq-agent

# RAG
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CHROMA_DIR=./chroma_db
DEVICE=cuda                   # cuda | cpu
